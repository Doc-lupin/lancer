{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lancer.local/schema/map.schema.json",
  "title": "Basin map",
  "description": "The single map data file (data/map.json). Field guide: data/schema/README.md. Cross-references (ids) and completeness rules are checked by tools/validate_map.py, not by this schema.",
  "type": "object",
  "required": ["schemaVersion", "basin", "clock", "layers", "alignments", "factions", "regions", "systems", "bodies", "places", "areas", "lanes", "units", "textBoxes", "headlines"],
  "properties": {
    "$schema": { "type": "string" },
    "_comment": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "basin": { "$ref": "#/$defs/basin" },
    "clock": { "$ref": "#/$defs/clock" },
    "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } },
    "alignments": { "type": "array", "items": { "$ref": "#/$defs/alignment" } },
    "factions": { "type": "array", "items": { "$ref": "#/$defs/faction" } },
    "feuds": { "type": "array", "items": { "$ref": "#/$defs/feud" } },
    "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
    "systems": { "type": "array", "items": { "$ref": "#/$defs/system" } },
    "bodies": { "type": "array", "items": { "$ref": "#/$defs/body" } },
    "places": { "type": "array", "items": { "$ref": "#/$defs/place" } },
    "areas": { "type": "array", "items": { "$ref": "#/$defs/area" } },
    "lanes": { "type": "array", "items": { "$ref": "#/$defs/lane" } },
    "units": { "type": "array", "items": { "$ref": "#/$defs/unit" } },
    "textBoxes": { "type": "array", "items": { "$ref": "#/$defs/textBox" } },
    "headlines": { "type": "array", "items": { "$ref": "#/$defs/headline" } }
  },
  "additionalProperties": false,

  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "idList": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "origin": { "enum": ["canon", "invented"] },
    "visibility": { "enum": ["all", "gm"] },
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "latLon": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number", "minimum": -180, "maximum": 180 }
      ],
      "minItems": 2, "maxItems": 2
    },
    "date": {
      "type": "object",
      "required": ["year", "day"],
      "properties": {
        "year": { "type": "integer" },
        "day": { "type": "integer", "minimum": 1, "maximum": 365 }
      },
      "additionalProperties": false
    },
    "latticeRating": { "enum": ["none", "trace", "small", "moderate", "rich", "very rich", "exceptional", "unknown"] },
    "lattice": {
      "type": "object",
      "required": ["rating"],
      "properties": {
        "rating": { "$ref": "#/$defs/latticeRating" },
        "trend": { "enum": ["rising", "falling", "steady"] },
        "where": { "type": "string" }
      },
      "additionalProperties": false
    },

    "tagged": {
      "type": "object",
      "required": ["id", "origin", "visibility"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "origin": { "$ref": "#/$defs/origin" },
        "visibility": { "$ref": "#/$defs/visibility" },
        "notes": { "type": "string" },
        "gmNotes": { "type": "string" },
        "_comment": { "type": "string" }
      }
    },
    "named": {
      "allOf": [{ "$ref": "#/$defs/tagged" }],
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "nameOrigin": { "$ref": "#/$defs/origin" },
        "pronunciation": { "type": "string", "description": "Gazetteer respelling, stressed syllable in capitals, e.g. TAL-iss." }
      }
    },

    "control": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["held", "contested", "none", "unknown"] },
        "holders": { "$ref": "#/$defs/idList" },
        "note": { "type": "string" }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "status": { "const": "held" } } }, "then": { "required": ["holders"], "properties": { "holders": { "minItems": 1 } } } },
        { "if": { "properties": { "status": { "const": "contested" } } }, "then": { "required": ["holders"], "properties": { "holders": { "minItems": 1 } } } },
        { "if": { "properties": { "status": { "enum": ["none", "unknown"] } } }, "then": { "properties": { "holders": { "maxItems": 0 } } } }
      ]
    },
    "presence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["faction"],
        "properties": {
          "faction": { "$ref": "#/$defs/id" },
          "strength": { "enum": ["major", "minor"] },
          "note": { "type": "string" },
          "visibility": { "$ref": "#/$defs/visibility" }
        },
        "additionalProperties": false
      }
    },

    "basin": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "properties": {
        "diameterLy": { "type": "number", "exclusiveMinimum": 0 },
        "axes": { "type": "string" }
      },
      "unevaluatedProperties": false
    },

    "tidalCycle": {
      "type": "object",
      "required": ["cycleDays", "openDays", "anchor"],
      "properties": {
        "cycleDays": { "type": "integer", "minimum": 1 },
        "openDays": { "type": "integer", "minimum": 0 },
        "anchor": {
          "type": "object",
          "required": ["date", "cycleDay"],
          "properties": {
            "date": { "$ref": "#/$defs/date" },
            "cycleDay": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "clock": {
      "type": "object",
      "required": ["daysPerYear", "basinYearOffset", "epoch", "current", "lanternTide"],
      "properties": {
        "daysPerYear": { "const": 365 },
        "basinYearOffset": { "type": "integer" },
        "epoch": { "$ref": "#/$defs/date" },
        "current": { "$ref": "#/$defs/date" },
        "lanternTide": { "$ref": "#/$defs/tidalCycle" },
        "_comment": { "type": "string" }
      },
      "additionalProperties": false
    },

    "layer": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "properties": {
        "kind": { "enum": ["governments", "corporations", "companies", "cultures", "religions", "other"] }
      },
      "required": ["kind"],
      "unevaluatedProperties": false
    },
    "alignment": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "unevaluatedProperties": false
    },
    "faction": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "required": ["category", "layers"],
      "properties": {
        "category": { "enum": ["government", "company", "outlaw", "commerce", "faith", "people"] },
        "layers": { "allOf": [{ "$ref": "#/$defs/idList" }], "minItems": 1 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "parent": { "$ref": "#/$defs/id" },
        "seat": { "$ref": "#/$defs/idList" },
        "seatDetail": { "type": "string" },
        "alignment": { "$ref": "#/$defs/id" },
        "alignmentNote": { "type": "string" },
        "leaders": { "type": "array", "items": { "type": "string" } },
        "strength": { "type": "string" },
        "population": { "type": "integer", "minimum": 0 },
        "latticeAtHome": { "type": "string" }
      },
      "unevaluatedProperties": false
    },
    "feud": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "required": ["sides"],
      "properties": {
        "sides": { "type": "array", "items": { "$ref": "#/$defs/idList" }, "minItems": 2 },
        "over": { "type": "string" },
        "regions": { "$ref": "#/$defs/idList" },
        "lanes": { "$ref": "#/$defs/idList" }
      },
      "unevaluatedProperties": false
    },

    "region": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "required": ["arm", "frontier", "pos", "effect", "control"],
      "properties": {
        "arm": { "enum": ["crossroads", "coreward", "trailing", "spinward", "rimward", "beyond"] },
        "frontier": { "type": "boolean" },
        "label": { "type": "string" },
        "chartPos": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "pos": { "$ref": "#/$defs/vec3" },
        "locked": { "type": "boolean" },
        "effect": { "enum": ["none", "nebula", "dust-cloud"] },
        "lattice": { "$ref": "#/$defs/lattice" },
        "control": { "$ref": "#/$defs/control" },
        "presence": { "$ref": "#/$defs/presence" }
      },
      "unevaluatedProperties": false
    },

    "starKind": {
      "description": "Main sequence, coolest to hottest; young; evolved; remnants; substellar.",
      "enum": [
        "red-dwarf", "orange-dwarf", "yellow-dwarf", "yellow-white-star", "white-star", "blue-white-star", "blue-star",
        "protostar",
        "subgiant", "red-giant", "orange-giant", "yellow-giant", "blue-giant", "red-supergiant", "blue-supergiant", "carbon-star", "wolf-rayet",
        "white-dwarf", "neutron-star", "pulsar", "magnetar", "black-hole", "remnant",
        "brown-dwarf"
      ]
    },
    "worldType": {"description": "World type ids. Descriptions, families and variants: data/schema/worlds.json and docs/WORLDS.md.", "enum": ["continental", "forest", "lake", "marsh", "ocean", "archipelago", "reef", "tropical", "monsoon", "megaflora", "fungal", "bioluminescent", "desert", "oasis", "arid", "mediterranean", "savanna", "steppe", "supercontinent", "tundra", "boreal", "alpine", "fjord", "arctic", "superhabitable", "karst", "tidally-locked", "geothermal", "seasonal", "dense-air", "thin-air", "toxic-air", "storm", "dust", "glassed", "salt", "high-gravity", "flare-scoured", "water-world", "barren", "super-earth", "iron", "carbon", "diamond", "chthonian", "lava", "volcanic", "hothouse", "pulsar-world", "shattered", "crystalline", "steam", "ice", "subglacial-ocean", "cryovolcanic", "methane-sea", "hydrocarbon", "snowball", "hycean", "hot-giant", "silicate-giant", "cloudless-giant", "warm-giant", "cold-giant", "puffy-giant", "helium-giant", "ice-giant", "mini-neptune", "dwarf-planet", "comet", "moonlet"]},
    "habitability": {"enum": ["garden", "habitable", "marginal", "hostile", "lethal", "none"]},
    "climate": {"enum": ["scorching", "hot", "warm", "temperate", "cool", "cold", "frozen"]},
    "worldFeature": {"enum": ["tidally-locked-to-parent", "eccentric-orbit", "retrograde-orbit", "resonant-orbit", "binary-planet", "trojan", "captured-body", "high-obliquity", "slow-rotation", "fast-rotation", "close-orbit", "distant-orbit", "circumbinary-orbit", "long-year", "short-year", "chaotic-rotation", "spin-orbit-resonance", "inclined-orbit", "migrating-orbit", "moonless", "single-large-moon", "many-moons", "shepherd-moons", "co-orbital-moons", "captured-moons", "habitable-moon", "dominant-parent", "submoon", "eclipsing-moons", "rings", "radiation", "strong-magnetosphere", "aurorae", "atmospheric-escape", "debris-field", "ring-arcs", "dusty-ring", "radiation-belts", "no-magnetosphere", "meteor-showers", "trojan-swarm", "twin-suns", "triple-suns", "dim-sun", "blue-sun", "giant-sun", "flaring-sun", "pulsar-sky", "starless-sky", "nebula-sky", "crowded-sky", "lantern-pulse", "frequent-eclipses", "colored-sky", "ring-shadow", "great-storm", "permanent-overcast", "superrotation", "dust-storms", "acid-rain", "extreme-lightning", "haze", "katabatic-winds", "seasonal-atmosphere", "cloud-bands", "fog-banks", "wildfires", "hail-storms", "cyclone-season", "high-uv", "gas-pockets", "still-air", "airglow", "rain-shadow", "extreme-seasons", "mild-seasons", "polar-night", "ice-age", "warming-climate", "cooling-climate", "unstable-climate", "ice-free-poles", "great-rivers", "inland-sea", "glaciers", "ice-caps", "hot-springs", "brine-pools", "deep-aquifers", "no-surface-water", "acid-seas", "soda-lakes", "tidal-bores", "whirlpools", "seasonal-floods", "underground-rivers", "sea-ice", "tidal-heating", "active-volcanism", "cryovolcanoes", "geysers", "subsurface-ocean", "extreme-tides", "impact-basin", "mega-canyon", "quakes", "caves", "low-gravity", "glassed-areas", "plate-tectonics", "tectonically-dead", "rift-valleys", "great-ranges", "shield-volcanoes", "supervolcano", "sinkholes", "unstable-ground", "landslides", "crystal-caverns", "salt-flats", "dune-seas", "ancient-surface", "recent-impact", "permafrost", "magnetic-anomalies", "flash-floods", "avalanches", "toxic-dust", "volcanic-winter", "endemic-disease", "unexploded-ordnance", "whiteouts", "tsunamis", "cave-ins", "quicksand", "native-life", "microbial-only", "megafauna", "dangerous-biosphere", "builder-organisms", "possible-sapience", "grazing-herds", "migratory-swarms", "apex-predators", "marine-megafauna", "aerial-life", "symbiotic-ecology", "chemosynthetic-life", "alien-biochemistry", "edible-biosphere", "invasive-species", "introduced-crops", "fossil-record", "extinct-biosphere", "hive-organisms", "venomous-fauna", "parasites", "deep-biosphere", "metal-ores", "rare-earths", "radioactives", "precious-metals", "water-ice-reserves", "volatiles", "helium-3", "deuterium", "hydrocarbons", "timber", "fisheries", "arable-land", "grazing-land", "geothermal-power", "medicinal-flora", "exotic-compounds", "salvage", "building-stone", "climate-engine", "failing-climate-engine", "heat-engine", "absent-ruins", "absent-signal", "custodians", "absent-platforms", "absent-towers", "absent-shipyard", "absent-wreckage", "buried-structure", "orbital-structure", "gravity-anomaly", "time-anomaly", "dormant-machinery", "powered-wreck", "sealed-chamber", "swept-space", "geometric-patterns", "lattice-seams", "lattice-crust", "lattice-dust", "lattice-rings", "lattice-nodules", "lattice-fields", "lattice-in-glass", "refined-lattice", "lattice-regrowth", "lattice-depleted", "lattice-resonance", "deep-lattice", "lane-mouth-nearby", "drifting-mouth", "picket", "orbital-station", "orbital-guns", "orbital-yards", "sensor-shadow", "navigation-hazard", "traffic-hub", "smuggler-anchorage", "survey-beacon", "uncharted-approaches", "abandoned-settlement", "quarantine", "battlefield", "wreck-field", "capital", "major-city", "company-town", "mining-camps", "refinery", "homesteads", "floating-towns", "sealed-towns", "research-station", "survey-camp", "mission", "refugee-settlements", "fortified", "occupied", "insurgency", "siege", "disputed-claims", "allotment-claims", "ghost-town", "crash-site", "memorial", "free-port"]},
    "worldStats": {"type": "object", "description": "Physical datablock, derived by tools/derive_stats.py; authored values in data/src/profiles.json win. Comparisons are to Union standard (Earth = 1). Guide: docs/DATABLOCK.md.", "properties": {"sizeClass": {"type": "string"}, "diameterKm": {"type": "number"}, "radiusRel": {"type": "number"}, "massRel": {"type": "number"}, "gravityG": {"type": "number"}, "escapeKms": {"type": "number"}, "orbitAccess": {"enum": ["easy", "standard", "costly", "very costly", "no surface"]}, "dayHours": {"type": ["number", "null"]}, "dayRel": {"type": ["number", "null"]}, "tidallyLocked": {"type": "boolean"}, "yearDays": {"type": ["number", "null"]}, "yearRel": {"type": ["number", "null"]}, "localDaysPerYear": {"type": ["number", "null"]}, "axialTiltDeg": {"type": ["number", "null"]}, "seasons": {"type": "string"}, "distanceAu": {"type": ["number", "null"]}, "insolationRel": {"type": ["number", "null"]}, "heatSource": {"type": "string"}, "tempMeanC": {"type": "number"}, "tempRangeC": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, "tempNote": {"type": "string"}, "pressureAtm": {"type": ["number", "null"]}, "breathability": {"enum": ["breathable", "breathable in season", "breathable with a gas mix", "mask required", "mask for exertion", "filter required", "sealed suit", "vacuum", "no surface"]}, "atmosphere": {"type": "string"}, "surface": {"type": ["object", "null"], "properties": {"water": {"type": "number"}, "land": {"type": "number"}, "ice": {"type": "number"}, "other": {"type": "number"}, "otherKind": {"type": "string"}}, "additionalProperties": false}, "precipitation": {"type": "string"}, "geology": {"enum": ["dead", "quiet", "active", "violent"]}, "radiation": {"type": "string"}, "sky": {"type": "object", "properties": {"color": {"type": "string"}, "sun": {"type": "string"}, "sunSizeRel": {"type": ["number", "null"]}, "objects": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}, "moons": {"type": "integer"}, "moonNames": {"type": "array", "items": {"type": "string"}}, "rings": {"type": "boolean"}, "biosphere": {"enum": ["none", "microbial", "simple", "complex", "complex, with megafauna", "extinct"]}, "nativeLife": {"type": "string"}, "absent": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "worldProfile": {"type": "object", "description": "Setting datablock for worlds and stations, as the Basin's survey and trade registers record it: travel, control, people, economy, ratings. Derived where possible; authored values in data/src/profiles.json win. Guide: docs/DATABLOCK.md.", "properties": {"surveyStatus": {"enum": ["settled", "surveyed", "partly surveyed", "seen from orbit only", "unvisited"]}, "authority": {"type": "string"}, "claims": {"type": "string"}, "security": {"type": "object", "required": ["rating", "reasons"], "properties": {"rating": {"type": "integer", "minimum": 1, "maximum": 5}, "reasons": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}, "hazard": {"type": "object", "required": ["rating", "reasons"], "properties": {"rating": {"type": "integer", "minimum": 1, "maximum": 5}, "reasons": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}, "navyReach": {"enum": ["Navy home waters", "within patrol range", "occasional patrols", "beyond the Navy's reach"]}, "toMarrow": {"type": "object", "properties": {"days": {"type": ["number", "null"]}, "route": {"type": "array", "items": {"type": "string"}}, "note": {"type": "string"}}, "additionalProperties": false}, "transitDays": {"type": "number"}, "transitFrom": {"type": "string"}, "portClass": {"type": "string"}, "defenses": {"type": "array", "items": {"type": "string"}}, "settlements": {"type": "object", "properties": {"count": {"type": "integer"}, "main": {"type": ["string", "null"]}, "notable": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}, "population": {"type": "integer", "minimum": 0}, "populationTrend": {"enum": ["uninhabited", "abandoned", "growing", "stable", "declining", "evacuating"]}, "settled": {"type": "integer"}, "peoples": {"type": "array", "items": {"type": "object", "required": ["faction", "strength"], "properties": {"faction": {"$ref": "#/$defs/id"}, "strength": {"enum": ["major", "minor"]}}, "additionalProperties": false}}, "faiths": {"type": "array", "items": {"type": "object", "required": ["faction", "strength"], "properties": {"faction": {"$ref": "#/$defs/id"}, "strength": {"enum": ["major", "minor"]}}, "additionalProperties": false}}, "economy": {"type": "object", "description": "Trade and supply. Destinations and sources follow the lane network, so an import names a supplier whose exports name the buyer.", "required": ["base", "exports", "imports", "resources", "levies", "printAccess", "food", "water"], "properties": {"base": {"type": "string", "description": "Primary activity, e.g. 'farming and ranching'; 'none' when uninhabited."}, "exports": {"type": "array", "items": {"type": "object", "required": ["good", "to"], "properties": {"good": {"type": "string"}, "class": {"type": "string"}, "to": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}}, "imports": {"type": "array", "items": {"type": "object", "required": ["good", "from"], "properties": {"good": {"type": "string"}, "class": {"type": "string"}, "from": {"type": "string"}}, "additionalProperties": false}}, "resources": {"type": "array", "description": "Known resources other than lattice.", "items": {"type": "object", "required": ["resource", "status"], "properties": {"resource": {"type": "string"}, "status": {"enum": ["worked", "unworked", "claimed, unworked", "closed by quarantine"]}}, "additionalProperties": false}}, "levies": {"type": "array", "items": {"type": "string"}, "description": "Tithes, tolls and protection paid on the world's trade routes."}, "printAccess": {"type": "string"}, "food": {"type": ["string", "null"]}, "water": {"type": ["string", "null"]}}, "additionalProperties": false}, "lattice": {"type": "object", "properties": {"rating": {"$ref": "#/$defs/latticeRating"}, "where": {"type": "string"}, "worked": {"type": "boolean"}, "workedBy": {"$ref": "#/$defs/idList"}}, "additionalProperties": false}, "code": {"type": "string"}}, "additionalProperties": false},
    "starFeature": { "enum": ["flares", "starspots", "debris-disk", "protoplanetary-disk", "accretion-disk", "planetary-nebula", "jets", "strong-wind"] },
    "variability": {
      "type": "object",
      "required": ["cycle"],
      "properties": {
        "cycle": { "enum": ["lantern", "natural"] },
        "periodDays": { "type": "number", "exclusiveMinimum": 0 },
        "amplitude": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false,
      "if": { "properties": { "cycle": { "const": "natural" } } },
      "then": { "required": ["periodDays"] },
      "else": { "not": { "required": ["periodDays"] } }
    },
    "system": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "required": ["charted", "pos", "center"],
      "properties": {
        "region": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "charted": { "type": "boolean" },
        "pos": { "$ref": "#/$defs/vec3" },
        "center": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["star", "rogue-planet", "wreck", "structure"] },
            "kind": { "$ref": "#/$defs/starKind" },
            "body": { "$ref": "#/$defs/id" },
            "variable": { "$ref": "#/$defs/variability" },
            "features": { "type": "array", "items": { "$ref": "#/$defs/starFeature" }, "uniqueItems": true }
          },
          "additionalProperties": false,
          "if": { "properties": { "type": { "const": "star" } } },
          "then": { "required": ["kind"], "not": { "required": ["body"] } },
          "else": { "required": ["body"], "not": { "anyOf": [{ "required": ["kind"] }, { "required": ["variable"] }, { "required": ["features"] }] } }
        },
        "lattice": { "$ref": "#/$defs/lattice" },
        "control": { "$ref": "#/$defs/control" },
        "presence": { "$ref": "#/$defs/presence" }
      },
      "unevaluatedProperties": false
    },

    "orbit": {
      "type": "object",
      "required": ["distance", "unit", "periodDays", "phaseDeg"],
      "properties": {
        "distance": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["au", "km"] },
        "periodDays": { "anyOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "null" }] },
        "phaseDeg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "inclinationDeg": { "type": "number", "minimum": -180, "maximum": 180 },
        "eccentricity": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 }
      },
      "additionalProperties": false
    },
    "body": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "required": ["system", "type"],
      "properties": {
        "system": { "$ref": "#/$defs/id" },
        "parent": { "$ref": "#/$defs/id" },
        "type": { "enum": ["star", "planet", "gas-giant", "moon", "rogue-planet", "asteroid", "asteroid-belt", "field", "station", "structure", "wreck", "lane-mouth"] },
        "kind": { "$ref": "#/$defs/starKind" },
        "variable": { "$ref": "#/$defs/variability" },
        "features": { "type": "array", "items": { "$ref": "#/$defs/starFeature" }, "uniqueItems": true },
        "class": { "type": "string" },
        "world": { "$ref": "#/$defs/worldType" },
        "variant": { "$ref": "#/$defs/id" },
        "habitability": { "$ref": "#/$defs/habitability" },
        "climate": { "$ref": "#/$defs/climate" },
        "worldFeatures": { "type": "array", "items": { "$ref": "#/$defs/worldFeature" }, "uniqueItems": true },
        "stats": { "$ref": "#/$defs/worldStats" },
        "profile": { "$ref": "#/$defs/worldProfile" },
        "orbit": { "$ref": "#/$defs/orbit" },
        "radiusKm": { "type": "number", "exclusiveMinimum": 0 },
        "rotation": {
          "type": "object",
          "properties": {
            "periodHours": { "type": "number", "exclusiveMinimum": 0 },
            "tidallyLocked": { "type": "boolean" },
            "axialTiltDeg": { "type": "number", "minimum": -180, "maximum": 180 }
          },
          "additionalProperties": false
        },
        "appearance": {
          "type": "object",
          "properties": {
            "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "texture": { "type": "string" },
            "clouds": { "type": "boolean" },
            "atmosphere": { "type": "boolean" },
            "rings": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "population": { "type": "integer", "minimum": 0 },
        "lattice": { "$ref": "#/$defs/lattice" },
        "control": { "$ref": "#/$defs/control" },
        "presence": { "$ref": "#/$defs/presence" }
      },
      "if": { "properties": { "type": { "const": "star" } } },
      "then": { "required": ["kind"] },
      "else": { "not": { "anyOf": [{ "required": ["kind"] }, { "required": ["variable"] }, { "required": ["features"] }] } },
      "unevaluatedProperties": false
    },

    "place": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "required": ["body", "kind", "at"],
      "properties": {
        "body": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["city", "town", "settlement", "base", "camp", "mine", "refinery", "port", "landing", "front", "battlefield", "structure", "ruin", "site", "other"] },
        "at": { "$ref": "#/$defs/latLon" },
        "path": { "type": "array", "items": { "$ref": "#/$defs/latLon" }, "minItems": 2 },
        "population": { "type": "integer", "minimum": 0 },
        "control": { "$ref": "#/$defs/control" }
      },
      "unevaluatedProperties": false
    },
    "area": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "required": ["body", "polygon", "control"],
      "properties": {
        "body": { "$ref": "#/$defs/id" },
        "polygon": { "type": "array", "items": { "$ref": "#/$defs/latLon" }, "minItems": 3 },
        "control": { "$ref": "#/$defs/control" }
      },
      "unevaluatedProperties": false
    },

    "laneEnd": {
      "type": "object",
      "required": ["region"],
      "properties": {
        "region": { "$ref": "#/$defs/id" },
        "system": { "$ref": "#/$defs/id" },
        "mouth": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "lane": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "required": ["from", "to", "days", "drifting", "oneWay", "silent"],
      "properties": {
        "from": { "$ref": "#/$defs/laneEnd" },
        "to": { "$ref": "#/$defs/laneEnd" },
        "scope": { "enum": ["primary", "local"] },
        "days": { "anyOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "null" }] },
        "daysRange": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 2, "maxItems": 2 },
        "drifting": { "type": "boolean" },
        "oneWay": { "type": "boolean" },
        "silent": { "type": "boolean" },
        "tidal": {
          "oneOf": [
            { "type": "object", "required": ["cycle"], "properties": { "cycle": { "enum": ["lantern", "unknown"] } }, "additionalProperties": false },
            { "type": "object", "required": ["cycle", "custom"], "properties": { "cycle": { "const": "custom" }, "custom": { "$ref": "#/$defs/tidalCycle" } }, "additionalProperties": false }
          ]
        },
        "bypass": { "type": "string" },
        "control": { "$ref": "#/$defs/control" }
      },
      "unevaluatedProperties": false
    },

    "location": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "region": { "$ref": "#/$defs/id" },
        "system": { "$ref": "#/$defs/id" },
        "body": { "$ref": "#/$defs/id" },
        "place": { "$ref": "#/$defs/id" },
        "lane": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "unit": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "required": ["faction", "kind", "location"],
      "properties": {
        "faction": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["fleet", "ship", "convoy", "frames", "troops", "other"] },
        "size": { "type": "string" },
        "location": { "$ref": "#/$defs/location" },
        "orders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["lanes", "status"],
            "properties": {
              "lanes": { "allOf": [{ "$ref": "#/$defs/idList" }], "minItems": 1 },
              "to": { "$ref": "#/$defs/location" },
              "depart": { "$ref": "#/$defs/date" },
              "status": { "enum": ["planned", "moving", "done", "cancelled"] },
              "visibility": { "$ref": "#/$defs/visibility" }
            },
            "additionalProperties": false
          }
        }
      },
      "unevaluatedProperties": false
    },

    "textBox": {
      "allOf": [{ "$ref": "#/$defs/tagged" }],
      "required": ["text", "anchor"],
      "properties": {
        "title": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "anchor": {
          "oneOf": [
            { "type": "object", "required": ["object"], "properties": { "object": { "$ref": "#/$defs/id" } }, "additionalProperties": false },
            {
              "type": "object", "required": ["screen"],
              "properties": { "screen": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "minItems": 2, "maxItems": 2 } },
              "additionalProperties": false
            }
          ]
        }
      },
      "unevaluatedProperties": false
    },
    "headline": {
      "allOf": [{ "$ref": "#/$defs/tagged" }],
      "required": ["text", "date"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/date" },
        "about": { "$ref": "#/$defs/idList" }
      },
      "unevaluatedProperties": false
    }
  }
}
