{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lancer.local/schema/map.schema.json",
  "title": "Basin map",
  "description": "The single map data file (data/map.json). Field guide: data/schema/README.md. Cross-references (ids) and completeness rules are checked by tools/validate_map.py, not by this schema.",
  "type": "object",
  "required": ["schemaVersion", "basin", "clock", "layers", "alignments", "factions", "regions", "systems", "bodies", "places", "areas", "lanes", "units", "textBoxes", "headlines"],
  "properties": {
    "$schema": { "type": "string" },
    "_comment": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "basin": { "$ref": "#/$defs/basin" },
    "clock": { "$ref": "#/$defs/clock" },
    "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } },
    "alignments": { "type": "array", "items": { "$ref": "#/$defs/alignment" } },
    "factions": { "type": "array", "items": { "$ref": "#/$defs/faction" } },
    "feuds": { "type": "array", "items": { "$ref": "#/$defs/feud" } },
    "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
    "systems": { "type": "array", "items": { "$ref": "#/$defs/system" } },
    "bodies": { "type": "array", "items": { "$ref": "#/$defs/body" } },
    "places": { "type": "array", "items": { "$ref": "#/$defs/place" } },
    "areas": { "type": "array", "items": { "$ref": "#/$defs/area" } },
    "lanes": { "type": "array", "items": { "$ref": "#/$defs/lane" } },
    "units": { "type": "array", "items": { "$ref": "#/$defs/unit" } },
    "textBoxes": { "type": "array", "items": { "$ref": "#/$defs/textBox" } },
    "headlines": { "type": "array", "items": { "$ref": "#/$defs/headline" } }
  },
  "additionalProperties": false,

  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "idList": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "origin": { "enum": ["canon", "invented"] },
    "visibility": { "enum": ["all", "gm"] },
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "latLon": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number", "minimum": -180, "maximum": 180 }
      ],
      "minItems": 2, "maxItems": 2
    },
    "date": {
      "type": "object",
      "required": ["year", "day"],
      "properties": {
        "year": { "type": "integer" },
        "day": { "type": "integer", "minimum": 1, "maximum": 365 }
      },
      "additionalProperties": false
    },
    "latticeRating": { "enum": ["none", "trace", "small", "moderate", "rich", "very rich", "exceptional", "unknown"] },
    "lattice": {
      "type": "object",
      "required": ["rating"],
      "properties": {
        "rating": { "$ref": "#/$defs/latticeRating" },
        "trend": { "enum": ["rising", "falling", "steady"] },
        "where": { "type": "string" }
      },
      "additionalProperties": false
    },

    "tagged": {
      "type": "object",
      "required": ["id", "origin", "visibility"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "origin": { "$ref": "#/$defs/origin" },
        "visibility": { "$ref": "#/$defs/visibility" },
        "notes": { "type": "string" },
        "gmNotes": { "type": "string" },
        "_comment": { "type": "string" }
      }
    },
    "named": {
      "allOf": [{ "$ref": "#/$defs/tagged" }],
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "nameOrigin": { "$ref": "#/$defs/origin" }
      }
    },

    "control": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["held", "contested", "none", "unknown"] },
        "holders": { "$ref": "#/$defs/idList" },
        "note": { "type": "string" }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "status": { "const": "held" } } }, "then": { "required": ["holders"], "properties": { "holders": { "minItems": 1 } } } },
        { "if": { "properties": { "status": { "const": "contested" } } }, "then": { "required": ["holders"], "properties": { "holders": { "minItems": 1 } } } },
        { "if": { "properties": { "status": { "enum": ["none", "unknown"] } } }, "then": { "properties": { "holders": { "maxItems": 0 } } } }
      ]
    },
    "presence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["faction"],
        "properties": {
          "faction": { "$ref": "#/$defs/id" },
          "strength": { "enum": ["major", "minor"] },
          "note": { "type": "string" },
          "visibility": { "$ref": "#/$defs/visibility" }
        },
        "additionalProperties": false
      }
    },

    "basin": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "properties": {
        "diameterLy": { "type": "number", "exclusiveMinimum": 0 },
        "axes": { "type": "string" }
      },
      "unevaluatedProperties": false
    },

    "tidalCycle": {
      "type": "object",
      "required": ["cycleDays", "openDays", "anchor"],
      "properties": {
        "cycleDays": { "type": "integer", "minimum": 1 },
        "openDays": { "type": "integer", "minimum": 0 },
        "anchor": {
          "type": "object",
          "required": ["date", "cycleDay"],
          "properties": {
            "date": { "$ref": "#/$defs/date" },
            "cycleDay": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "clock": {
      "type": "object",
      "required": ["daysPerYear", "basinYearOffset", "epoch", "current", "lanternTide"],
      "properties": {
        "daysPerYear": { "const": 365 },
        "basinYearOffset": { "type": "integer" },
        "epoch": { "$ref": "#/$defs/date" },
        "current": { "$ref": "#/$defs/date" },
        "lanternTide": { "$ref": "#/$defs/tidalCycle" },
        "_comment": { "type": "string" }
      },
      "additionalProperties": false
    },

    "layer": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "properties": {
        "kind": { "enum": ["governments", "corporations", "companies", "cultures", "religions", "other"] }
      },
      "required": ["kind"],
      "unevaluatedProperties": false
    },
    "alignment": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "unevaluatedProperties": false
    },
    "faction": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "required": ["category", "layers"],
      "properties": {
        "category": { "enum": ["government", "company", "outlaw", "commerce", "faith", "people"] },
        "layers": { "allOf": [{ "$ref": "#/$defs/idList" }], "minItems": 1 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "parent": { "$ref": "#/$defs/id" },
        "seat": { "$ref": "#/$defs/idList" },
        "seatDetail": { "type": "string" },
        "alignment": { "$ref": "#/$defs/id" },
        "alignmentNote": { "type": "string" },
        "leaders": { "type": "array", "items": { "type": "string" } },
        "strength": { "type": "string" },
        "population": { "type": "integer", "minimum": 0 },
        "latticeAtHome": { "type": "string" }
      },
      "unevaluatedProperties": false
    },
    "feud": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "required": ["sides"],
      "properties": {
        "sides": { "type": "array", "items": { "$ref": "#/$defs/idList" }, "minItems": 2 },
        "over": { "type": "string" },
        "regions": { "$ref": "#/$defs/idList" },
        "lanes": { "$ref": "#/$defs/idList" }
      },
      "unevaluatedProperties": false
    },

    "region": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "required": ["arm", "frontier", "pos", "effect", "control"],
      "properties": {
        "arm": { "enum": ["crossroads", "coreward", "trailing", "spinward", "rimward", "beyond"] },
        "frontier": { "type": "boolean" },
        "label": { "type": "string" },
        "chartPos": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "pos": { "$ref": "#/$defs/vec3" },
        "locked": { "type": "boolean" },
        "effect": { "enum": ["none", "nebula", "dust-cloud"] },
        "lattice": { "$ref": "#/$defs/lattice" },
        "control": { "$ref": "#/$defs/control" },
        "presence": { "$ref": "#/$defs/presence" }
      },
      "unevaluatedProperties": false
    },

    "starKind": {
      "description": "Main sequence, coolest to hottest; young; evolved; remnants; substellar.",
      "enum": [
        "red-dwarf", "orange-dwarf", "yellow-dwarf", "yellow-white-star", "white-star", "blue-white-star", "blue-star",
        "protostar",
        "subgiant", "red-giant", "orange-giant", "yellow-giant", "blue-giant", "red-supergiant", "blue-supergiant", "carbon-star", "wolf-rayet",
        "white-dwarf", "neutron-star", "pulsar", "magnetar", "black-hole", "remnant",
        "brown-dwarf"
      ]
    },
    "worldType": {"description": "Catalog of world types. The title is the family; docs/WORLDS.md is generated from this.", "oneOf": [{"const": "continental", "title": "habitable-wet", "description": "Large continents of forest, grassland and river, with open seas between."}, {"const": "forest", "title": "habitable-wet", "description": "Canopy over most of the land; long rivers and deep soil."}, {"const": "lake", "title": "habitable-wet", "description": "Land scoured into thousands of lakes and channels."}, {"const": "marsh", "title": "habitable-wet", "description": "Low, waterlogged country: fens, peat and slow brown rivers."}, {"const": "ocean", "title": "habitable-wet", "description": "A world ocean with scattered islands."}, {"const": "archipelago", "title": "habitable-wet", "description": "Chains of volcanic islands in shallow seas, flooded and drained by the tides."}, {"const": "reef", "title": "habitable-wet", "description": "Shallow seas built up by reef-forming life; most land is living rock."}, {"const": "tropical", "title": "habitable-wet", "description": "Hot and wet, rainforest from coast to mountain."}, {"const": "monsoon", "title": "habitable-wet", "description": "Seasons of flood and drought; rivers that change course."}, {"const": "megaflora", "title": "habitable-wet", "description": "Plant life on a giant scale; forests hundreds of meters tall."}, {"const": "fungal", "title": "habitable-wet", "description": "A biosphere dominated by fungi and molds; spore fogs at dawn."}, {"const": "bioluminescent", "title": "habitable-wet", "description": "Life that glows; nights brighter than some days."}, {"const": "desert", "title": "habitable-dry", "description": "Sand seas and bare rock; water only underground or at the poles."}, {"const": "oasis", "title": "habitable-dry", "description": "Mostly desert, with life gathered around deep aquifers and springs."}, {"const": "arid", "title": "habitable-dry", "description": "Mesas, badlands and canyons; short, violent rains."}, {"const": "mediterranean", "title": "habitable-dry", "description": "Dry summers, wet winters; scrub, orchards and rocky coasts."}, {"const": "savanna", "title": "habitable-dry", "description": "Grassland with scattered trees and a long dry season."}, {"const": "steppe", "title": "habitable-dry", "description": "Cold, dry grassland; wind and open distance."}, {"const": "supercontinent", "title": "habitable-dry", "description": "One huge landmass with a dry interior and green coasts."}, {"const": "tundra", "title": "habitable-cold", "description": "Permafrost, moss and lichen; short summers."}, {"const": "boreal", "title": "habitable-cold", "description": "Endless conifer forest and bog; long winters."}, {"const": "alpine", "title": "habitable-cold", "description": "High mountains and plateaus; thin, cold air on the heights."}, {"const": "fjord", "title": "habitable-cold", "description": "Glacier-cut coasts and deep inlets; cold, wet, forested valleys."}, {"const": "arctic", "title": "habitable-cold", "description": "Ice sheets over most of the world; life on the coasts and in the sea."}, {"const": "superhabitable", "title": "habitable-special", "description": "Larger and kinder to life than any settler's home: more land, richer seas, heavier gravity."}, {"const": "karst", "title": "habitable-special", "description": "Limestone country riddled with caves, sinkholes and underground rivers; rich in minerals."}, {"const": "tidally-locked", "title": "habitable-special", "description": "One face always to its star: a burning day side, a frozen night side and a living twilight band."}, {"const": "geothermal", "title": "habitable-special", "description": "A cold world warmed from below; life clusters around vents and hot springs."}, {"const": "seasonal", "title": "marginal", "description": "Breathable for part of the year only."}, {"const": "dense-air", "title": "marginal", "description": "Thick, heavy air and permanent overcast; breathable only with care."}, {"const": "thin-air", "title": "marginal", "description": "Thin, cold air; masks outdoors."}, {"const": "toxic-air", "title": "marginal", "description": "Air that needs filters, and life that tolerates it."}, {"const": "storm", "title": "marginal", "description": "Perpetual storms and surge; shelter is survival."}, {"const": "dust", "title": "marginal", "description": "Dust storms that cover the world for months."}, {"const": "glassed", "title": "marginal", "description": "Plains fused to glass by some ancient catastrophe."}, {"const": "salt", "title": "marginal", "description": "Salt pans and brine lakes; hardy life at the margins."}, {"const": "high-gravity", "title": "marginal", "description": "Gravity that wears down bodies and machines; thick, low air."}, {"const": "flare-scoured", "title": "marginal", "description": "Swept by stellar flares; life underground or on the night side."}, {"const": "barren", "title": "rocky", "description": "Airless, cratered rock."}, {"const": "super-earth", "title": "rocky", "description": "A large rocky world with no native life; thin or heavy air."}, {"const": "iron", "title": "rocky", "description": "Mostly metal core; dense, dark and rich in ore."}, {"const": "carbon", "title": "rocky", "description": "Graphite plains, tar pits and carbide mountains."}, {"const": "diamond", "title": "rocky", "description": "A carbon crust pressed into diamond."}, {"const": "chthonian", "title": "rocky", "description": "The stripped core of a gas giant that strayed too close to its star."}, {"const": "lava", "title": "rocky", "description": "A molten or half-molten surface."}, {"const": "volcanic", "title": "rocky", "description": "Constant eruptions and sulfur plains, usually from tidal heating."}, {"const": "hothouse", "title": "rocky", "description": "Runaway greenhouse: crushing, scalding air under acid cloud."}, {"const": "pulsar-world", "title": "rocky", "description": "Scoured by a pulsar's beam; glassy, irradiated rock."}, {"const": "shattered", "title": "rocky", "description": "Broken by tides or collision; a loose pile of rubble held by its own weight."}, {"const": "crystalline", "title": "rocky", "description": "Crusted with lattice laid down from outside, as on the Pale's airless worlds."}, {"const": "ice", "title": "icy", "description": "A frozen surface of water ice and rock."}, {"const": "subglacial-ocean", "title": "icy", "description": "A liquid ocean under kilometers of ice."}, {"const": "cryovolcanic", "title": "icy", "description": "Ice volcanoes and geysers."}, {"const": "methane-sea", "title": "icy", "description": "Lakes and seas of liquid methane and ethane under an orange haze."}, {"const": "hydrocarbon", "title": "icy", "description": "Tar seas and waxy hydrocarbon dunes."}, {"const": "snowball", "title": "icy", "description": "A once-temperate world frozen solid."}, {"const": "hot-giant", "title": "giant", "description": "A close-orbiting gas giant, bloated and glowing."}, {"const": "silicate-giant", "title": "giant", "description": "So hot that its clouds are rock vapor; glows red on the night side."}, {"const": "cloudless-giant", "title": "giant", "description": "Too warm for ammonia, too cool for water: deep, clear blue."}, {"const": "warm-giant", "title": "giant", "description": "Bright white water-vapor clouds."}, {"const": "cold-giant", "title": "giant", "description": "Banded ammonia clouds; the classic gas giant."}, {"const": "puffy-giant", "title": "giant", "description": "Very low density; its atmosphere bleeds into space."}, {"const": "helium-giant", "title": "giant", "description": "Hydrogen-poor; pale grey and white."}, {"const": "ice-giant", "title": "giant", "description": "Water, ammonia and methane under a blue-green haze."}, {"const": "mini-neptune", "title": "giant", "description": "A small gas world: deep atmosphere and no surface."}, {"const": "dwarf-planet", "title": "small", "description": "A small round world."}, {"const": "comet", "title": "small", "description": "A captured comet: dust, ice and jets."}, {"const": "moonlet", "title": "small", "description": "A small, irregular moon or rock."}]},
    "habitability": {"enum": ["garden", "habitable", "marginal", "hostile", "lethal", "none"]},
    "climate": {"enum": ["scorching", "hot", "warm", "temperate", "cool", "cold", "frozen"]},
    "worldFeature": {"enum": ["rings", "great-storm", "aurorae", "tidal-heating", "eccentric-orbit", "retrograde-orbit", "resonant-orbit", "binary-planet", "cryovolcanoes", "geysers", "subsurface-ocean", "radiation", "low-gravity", "native-life", "megafauna", "climate-engine", "failing-climate-engine", "heat-engine", "absent-ruins", "custodians", "lattice-seams", "lattice-crust", "glassed-areas"]},
    "starFeature": { "enum": ["flares", "starspots", "debris-disk", "protoplanetary-disk", "accretion-disk", "planetary-nebula", "jets", "strong-wind"] },
    "variability": {
      "type": "object",
      "required": ["cycle"],
      "properties": {
        "cycle": { "enum": ["lantern", "natural"] },
        "periodDays": { "type": "number", "exclusiveMinimum": 0 },
        "amplitude": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false,
      "if": { "properties": { "cycle": { "const": "natural" } } },
      "then": { "required": ["periodDays"] },
      "else": { "not": { "required": ["periodDays"] } }
    },
    "system": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "required": ["charted", "pos", "center"],
      "properties": {
        "region": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "charted": { "type": "boolean" },
        "pos": { "$ref": "#/$defs/vec3" },
        "center": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["star", "rogue-planet", "wreck", "structure"] },
            "kind": { "$ref": "#/$defs/starKind" },
            "body": { "$ref": "#/$defs/id" },
            "variable": { "$ref": "#/$defs/variability" },
            "features": { "type": "array", "items": { "$ref": "#/$defs/starFeature" }, "uniqueItems": true }
          },
          "additionalProperties": false,
          "if": { "properties": { "type": { "const": "star" } } },
          "then": { "required": ["kind"], "not": { "required": ["body"] } },
          "else": { "required": ["body"], "not": { "anyOf": [{ "required": ["kind"] }, { "required": ["variable"] }, { "required": ["features"] }] } }
        },
        "lattice": { "$ref": "#/$defs/lattice" },
        "control": { "$ref": "#/$defs/control" },
        "presence": { "$ref": "#/$defs/presence" }
      },
      "unevaluatedProperties": false
    },

    "orbit": {
      "type": "object",
      "required": ["distance", "unit", "periodDays", "phaseDeg"],
      "properties": {
        "distance": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["au", "km"] },
        "periodDays": { "anyOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "null" }] },
        "phaseDeg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "inclinationDeg": { "type": "number", "minimum": -180, "maximum": 180 },
        "eccentricity": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 }
      },
      "additionalProperties": false
    },
    "body": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "required": ["system", "type"],
      "properties": {
        "system": { "$ref": "#/$defs/id" },
        "parent": { "$ref": "#/$defs/id" },
        "type": { "enum": ["star", "planet", "gas-giant", "moon", "rogue-planet", "asteroid", "asteroid-belt", "field", "station", "structure", "wreck", "lane-mouth"] },
        "kind": { "$ref": "#/$defs/starKind" },
        "variable": { "$ref": "#/$defs/variability" },
        "features": { "type": "array", "items": { "$ref": "#/$defs/starFeature" }, "uniqueItems": true },
        "class": { "type": "string" },
        "world": { "$ref": "#/$defs/worldType" },
        "habitability": { "$ref": "#/$defs/habitability" },
        "climate": { "$ref": "#/$defs/climate" },
        "worldFeatures": { "type": "array", "items": { "$ref": "#/$defs/worldFeature" }, "uniqueItems": true },
        "orbit": { "$ref": "#/$defs/orbit" },
        "radiusKm": { "type": "number", "exclusiveMinimum": 0 },
        "rotation": {
          "type": "object",
          "properties": {
            "periodHours": { "type": "number", "exclusiveMinimum": 0 },
            "tidallyLocked": { "type": "boolean" },
            "axialTiltDeg": { "type": "number", "minimum": -180, "maximum": 180 }
          },
          "additionalProperties": false
        },
        "appearance": {
          "type": "object",
          "properties": {
            "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "texture": { "type": "string" },
            "clouds": { "type": "boolean" },
            "atmosphere": { "type": "boolean" },
            "rings": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "population": { "type": "integer", "minimum": 0 },
        "lattice": { "$ref": "#/$defs/lattice" },
        "control": { "$ref": "#/$defs/control" },
        "presence": { "$ref": "#/$defs/presence" }
      },
      "if": { "properties": { "type": { "const": "star" } } },
      "then": { "required": ["kind"] },
      "else": { "not": { "anyOf": [{ "required": ["kind"] }, { "required": ["variable"] }, { "required": ["features"] }] } },
      "unevaluatedProperties": false
    },

    "place": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "required": ["body", "kind", "at"],
      "properties": {
        "body": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["city", "town", "settlement", "base", "camp", "mine", "refinery", "port", "landing", "front", "battlefield", "structure", "ruin", "site", "other"] },
        "at": { "$ref": "#/$defs/latLon" },
        "path": { "type": "array", "items": { "$ref": "#/$defs/latLon" }, "minItems": 2 },
        "population": { "type": "integer", "minimum": 0 },
        "control": { "$ref": "#/$defs/control" }
      },
      "unevaluatedProperties": false
    },
    "area": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "required": ["body", "polygon", "control"],
      "properties": {
        "body": { "$ref": "#/$defs/id" },
        "polygon": { "type": "array", "items": { "$ref": "#/$defs/latLon" }, "minItems": 3 },
        "control": { "$ref": "#/$defs/control" }
      },
      "unevaluatedProperties": false
    },

    "laneEnd": {
      "type": "object",
      "required": ["region"],
      "properties": {
        "region": { "$ref": "#/$defs/id" },
        "system": { "$ref": "#/$defs/id" },
        "mouth": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "lane": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "required": ["from", "to", "days", "drifting", "oneWay", "silent"],
      "properties": {
        "from": { "$ref": "#/$defs/laneEnd" },
        "to": { "$ref": "#/$defs/laneEnd" },
        "scope": { "enum": ["primary", "local"] },
        "days": { "anyOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "null" }] },
        "daysRange": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 2, "maxItems": 2 },
        "drifting": { "type": "boolean" },
        "oneWay": { "type": "boolean" },
        "silent": { "type": "boolean" },
        "tidal": {
          "oneOf": [
            { "type": "object", "required": ["cycle"], "properties": { "cycle": { "enum": ["lantern", "unknown"] } }, "additionalProperties": false },
            { "type": "object", "required": ["cycle", "custom"], "properties": { "cycle": { "const": "custom" }, "custom": { "$ref": "#/$defs/tidalCycle" } }, "additionalProperties": false }
          ]
        },
        "bypass": { "type": "string" },
        "control": { "$ref": "#/$defs/control" }
      },
      "unevaluatedProperties": false
    },

    "location": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "region": { "$ref": "#/$defs/id" },
        "system": { "$ref": "#/$defs/id" },
        "body": { "$ref": "#/$defs/id" },
        "place": { "$ref": "#/$defs/id" },
        "lane": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "unit": {
      "allOf": [{ "$ref": "#/$defs/named" }],
      "required": ["faction", "kind", "location"],
      "properties": {
        "faction": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["fleet", "ship", "convoy", "frames", "troops", "other"] },
        "size": { "type": "string" },
        "location": { "$ref": "#/$defs/location" },
        "orders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["lanes", "status"],
            "properties": {
              "lanes": { "allOf": [{ "$ref": "#/$defs/idList" }], "minItems": 1 },
              "to": { "$ref": "#/$defs/location" },
              "depart": { "$ref": "#/$defs/date" },
              "status": { "enum": ["planned", "moving", "done", "cancelled"] },
              "visibility": { "$ref": "#/$defs/visibility" }
            },
            "additionalProperties": false
          }
        }
      },
      "unevaluatedProperties": false
    },

    "textBox": {
      "allOf": [{ "$ref": "#/$defs/tagged" }],
      "required": ["text", "anchor"],
      "properties": {
        "title": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "anchor": {
          "oneOf": [
            { "type": "object", "required": ["object"], "properties": { "object": { "$ref": "#/$defs/id" } }, "additionalProperties": false },
            {
              "type": "object", "required": ["screen"],
              "properties": { "screen": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "minItems": 2, "maxItems": 2 } },
              "additionalProperties": false
            }
          ]
        }
      },
      "unevaluatedProperties": false
    },
    "headline": {
      "allOf": [{ "$ref": "#/$defs/tagged" }],
      "required": ["text", "date"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/date" },
        "about": { "$ref": "#/$defs/idList" }
      },
      "unevaluatedProperties": false
    }
  }
}
